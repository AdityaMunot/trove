#!/usr/bin/env bash
# After rebase/amend: reopen any done todo whose closed_by_commit is no
# longer reachable from HEAD. Delegated to `todo verify --fix`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
TODO="__TODO_DISPATCHER__"   # substituted by install-hooks at copy time
[[ -f "$TODO" ]] || exit 0
TODOS_DIR="$REPO_ROOT/.claude/todos"
[[ -d "$TODOS_DIR" ]] || exit 0

bash "$TODO" verify --fix --dir "$TODOS_DIR" || true
